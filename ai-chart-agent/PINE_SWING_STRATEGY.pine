// ============================================================
// NSE Swing 2-5-8 : 20-day Breakout + EMA50 trend + Volume
// Matches rules.json of your Kotak bot. Use on 1D (daily).
// Works on FREE TradingView. Paste: Pine Editor -> Add to chart.
// ============================================================
//@version=5
strategy("NSE Swing 2-5-8", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=25,
     max_bars_back=500)

// ---- Inputs (same numbers as your Kotak bot) ----
lenHigh = input.int(20, "Breakout length")
lenFast = input.int(20, "Fast EMA")
lenSlow = input.int(50, "Slow EMA")
lenVol  = input.int(20, "Volume avg length")
volMult = input.float(1.3, "Volume multiple", step=0.1)
rsiLen  = input.int(14, "RSI length")
slPct   = input.float(2.0, "Stop %") / 100
t1Pct   = input.float(5.0, "Target1 %") / 100
t2Pct   = input.float(8.0, "Target2 %") / 100
maxHold = input.int(10, "Max hold (bars)")

// ---- Indicators ----
emaF = ta.ema(close, lenFast)
emaS = ta.ema(close, lenSlow)
prevHigh = ta.highest(high, lenHigh)[1]   // 20-day high BEFORE today
avgVol = ta.sma(volume, lenVol)
r = ta.rsi(close, rsiLen)

// ---- Entry: score-70 logic ----
longOK = close > prevHigh and close > emaS and emaF > emaS and
     volume >= avgVol * volMult and r > 55 and r < 80

if longOK and strategy.position_size == 0
    strategy.entry("SwingL", strategy.long)

// ---- Exits: SL 2% | T1 5% half + breakeven | T2 8% | 10-bar stop ----
if strategy.position_size > 0
    entryPx = strategy.opentrades.entry_price(0)
    slPx = entryPx * (1 - slPct)
    t1Px = entryPx * (1 + t1Pct)
    t2Px = entryPx * (1 + t2Pct)
    barsIn = bar_index - strategy.opentrades.entry_bar_index(0)
    // once price touches T1 zone, protect T2 leg at breakeven
    slPx2 = high >= t1Px ? entryPx : slPx
    strategy.exit("T1", from_entry="SwingL", qty_percent=50, limit=t1Px, stop=slPx)
    strategy.exit("T2", from_entry="SwingL", limit=t2Px, stop=slPx2)
    if barsIn >= maxHold
        strategy.close("SwingL", comment="TimeStop")

// ---- Drawings ----
plot(emaF, "EMA20", color=color.orange)
plot(emaS, "EMA50", color=color.blue)
plot(prevHigh, "20D High", color=color.new(color.green, 0), style=plot.style_linebr)
bgcolor(longOK ? color.new(color.green, 85) : na, title="Setup bar")
