+            rows = resp.get("data") if isinstance(resp, dict) else resp
+            out["kotak_raw"] = rows if isinstance(rows, list) else resp
+        except Exception as e:
+            out["error"] = (out["error"] + f" | kotak: {e}").strip(" |")
