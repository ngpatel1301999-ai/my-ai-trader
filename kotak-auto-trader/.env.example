# ===== COPY TO .env AND FILL. NEVER SHARE .env =====

# --- Mode: swing | intraday | both. Paper = fake money (safe default) ---
BOT_MODE=swing
TRADING_MODE=paper
ENABLE_LIVE_ORDERS=false

# --- Kotak Neo (app -> More -> Trade API -> API Dashboard) ---
NEO_CONSUMER_KEY=PASTE_TOKEN_HERE
NEO_MOBILE_NUMBER=+91XXXXXXXXXX
NEO_UCC=YOUR_UCC
NEO_MPIN=123456
NEO_TOTP_SECRET=PASTE_TOTP_SECRET_HERE

# --- Telegram remote (free) ---
TELEGRAM_BOT_TOKEN=PASTE_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=PASTE_YOUR_NUMERIC_ID_HERE

# --- AI brain: FREE Gemini key from https://aistudio.google.com ---
GEMINI_API_KEY=PASTE_FREE_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# --- Extra AI keys (ALL optional. Any key added = auto-joins the brain chain) ---
# FREE signups: Groq, Cerebras, OpenRouter, Together, Fireworks, SambaNova,
# HuggingFace, GitHub Models (uses your GitHub!), NVIDIA, Nebius, Zhipu, SiliconFlow
AI_PROVIDERS=gemini,groq,cerebras,openrouter
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
SAMBANOVA_API_KEY=
HYPERBOLIC_API_KEY=
HF_TOKEN=
GITHUB_TOKEN=
NVIDIA_API_KEY=
NEBIUS_API_KEY=
ZHIPU_API_KEY=
DASHSCOPE_API_KEY=
SILICONFLOW_API_KEY=
COHERE_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
# Local laptop brains (add ollama/lmstudio to AI_PROVIDERS to use, no key needed)
# Any other OpenAI-compatible endpoint:
#CUSTOM1_BASE=https://...
#CUSTOM1_KEY=
#CUSTOM1_MODEL=

# --- AI PERMISSIONS (only YOU can change these, AI cannot) ---
AI_PAPER_TRADING=true
AI_TRADING_ENABLED=false
AI_REQUIRE_APPROVAL=true
AI_MAX_ORDER_VALUE_RS=10000

# --- Stocks: plain names, tokens auto-found! ---
WATCHLIST=RELIANCE,INFY,TCS,HDFCBANK,TMPV,TMCV,SBIN,ICICIBANK,LT

# --- Intraday ORB risk ---
QTY_PER_TRADE=1
MAX_DAILY_LOSS_RS=2000
MAX_TRADES_PER_DAY=4
TARGET_R_MULTIPLE=1.5
PRODUCT=MIS
POLL_SECONDS=5

# --- Swing: sid44 = Siddharth Bhanushali 44-MA sniper (default). classic = old breakout ---
SWING_STRATEGY=sid44
SWING_SL_PCT=2
SWING_T1_PCT=5
SWING_T2_PCT=8
MAX_HOLD_DAYS=10
MAX_SWING_POSITIONS=3
MAX_NEW_PER_DAY=2
SWING_MIN_SCORE=70
SWING_AUTO_BUY=false
RISK_PER_TRADE_RS=1000
MAX_POSITION_VALUE_RS=30000
SCAN_TIME=15:20
GUARDIAN_SECONDS=60
